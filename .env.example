# 站点
NEXT_PUBLIC_SITE_URL=https://aiabw.com

# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# 可选：仅服务端可读（不暴露给浏览器打包）；未设置公开 anon 时代码会尝试此项
SUPABASE_ANON_KEY=
# 管理后台写操作 / 看板统计用（勿提交到前端）。若暂未配置 anon，服务端读接口会临时回退此项并打警告日志
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 设为 1 时，/api/tools 等非 PostgREST 错误会附带 debug 字段（仅本地排查）
DEBUG_SUPABASE_API=

# 管理后台（务必使用强密码；JWT 签名建议单独随机串）
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=random-long-string

# Google（可选）
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
